<Window x:Class="PausaVital.Views.ClosePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exit"
        Height="260"
        Width="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F4F8"
        ShowInTaskbar="False"
        Topmost="True">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Name="TitleText"
                   Text="How do you want to close the app?"
                   FontSize="18"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Name="DescriptionText"
                   Text="You can keep Pausa Vital running in the background to maintain your streaks, or exit completely."
                   TextWrapping="Wrap"
                   FontSize="14"
                   Foreground="#7F8C8D"
                   LineHeight="20"
                   Margin="0,0,0,18"/>

        <CheckBox Grid.Row="2"
                  Name="RememberCheckBox"
                  Content="Remember my choice and don't ask again"
                  Foreground="#34495E"
                  FontSize="14"
                  VerticalContentAlignment="Center"
                  Margin="0,0,0,20"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Name="MinimizeButton"
                    Content="Minimize to Tray"
                    Height="44"
                    Background="#2980B9"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnMinimizeClicked">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>

            <Button Grid.Column="2"
                    Name="ExitButton"
                    Content="Exit Completely"
                    Height="44"
                    Background="#E74C3C"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnExitClicked">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Grid>
</Window>