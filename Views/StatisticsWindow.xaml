<Window x:Class="PausaVital.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Estadísticas avanzadas"
        Height="480"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">

            <TextBlock Text="&#xE9D9;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="26"
                       Foreground="#2C3E50"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"/>

            <TextBlock Text="Resumen de rendimiento"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Estadísticas -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center">

            <!-- Tasa de éxito -->
            <Border Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Margin="0,0,0,15">

                <Border.Effect>
                    <DropShadowEffect Color="Black"
                                      Opacity="0.05"
                                      BlurRadius="10"
                                      ShadowDepth="2"/>
                </Border.Effect>

                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock Text="&#xE81E;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   Foreground="#F1C40F"
                                   Margin="0,0,6,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="TASA DE ÉXITO"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#95A5A6"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="SuccessRateText"
                               Text="0%"
                               FontSize="48"
                               FontWeight="Light"
                               Foreground="#27AE60"
                               HorizontalAlignment="Center"
                               Margin="0,5,0,10"/>

                    <ProgressBar x:Name="SuccessProgressBar"
                                 Height="8"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Foreground="#27AE60"
                                 Background="#ECF0F1"
                                 BorderThickness="0"/>
                </StackPanel>
            </Border>

            <!-- Completados y fallidos -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="White"
                        CornerRadius="12"
                        Padding="15">

                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          Opacity="0.05"
                                          BlurRadius="10"
                                          ShadowDepth="2"/>
                    </Border.Effect>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="&#xE73E;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#2980B9"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="COMPLETADOS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#95A5A6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="CompletedText"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#2980B9"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="White"
                        CornerRadius="12"
                        Padding="15">

                    <Border.Effect>
                        <DropShadowEffect Color="Black"
                                          Opacity="0.05"
                                          BlurRadius="10"
                                          ShadowDepth="2"/>
                    </Border.Effect>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <TextBlock Text="&#xE711;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="12"
                                       Foreground="#E74C3C"
                                       Margin="0,0,5,0"
                                       VerticalAlignment="Center"/>

                            <TextBlock Text="FALLIDOS"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#95A5A6"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="FailedText"
                                   Text="0"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   Foreground="#E74C3C"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- Tiempo de inactividad -->
        <Border Grid.Row="2"
                Background="#E8ECEF"
                CornerRadius="8"
                Padding="10"
                Margin="0,20,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="&#xE823;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="#7F8C8D"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>

                <TextBlock Text="Inactividad del sistema: "
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#7F8C8D"
                           VerticalAlignment="Center"/>

                <TextBlock x:Name="LiveIdleText"
                           Text="00:00"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#34495E"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Botón cerrar -->
        <Button Grid.Row="3"
                Background="#ECF0F1"
                Foreground="#34495E"
                BorderThickness="0"
                Padding="10"
                Margin="0,15,0,0"
                Cursor="Hand"
                Click="OnCloseButtonClicked">

            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="&#xE8BB;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="10"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           FontWeight="Bold"/>

                <TextBlock Text="Cerrar panel"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>