<Window x:Class="PausaVital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pausa Vital" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

	<Grid Background="#F5F5F5">
		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Pausa Vital Dashboard"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

		<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">

			<TextBlock Name="StreakText"
                       Text="Current Streak: 0 Breaks"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

			<TextBlock Name="ConnectionStatusText"
                       Text="Checking connection..."
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="Gray"/>
			
			<TextBlock Name="WorkTimeText"
					   Text="Work Time: 00:00"
					   FontSize="18"
					   FontWeight="Bold"
					   HorizontalAlignment="Center"
					   Margin="0,0,0,5"
					   Foreground="#005A9C"/>

			<TextBlock Name="IdleTimeText"
                       Text="Idle Time: 0 seconds"
                       FontSize="16"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"
                       Foreground="#333333"/>

			<Button Name="TestBreakButton"
                    Content="[TEST] Simulate Break"
                    Width="180"
                    Height="35"
                    FontSize="14"
                    Margin="0,0,0,10"
                    Background="LightCyan"
                    Click="OnTestBreakButtonClicked"/>

			<Button Name="HideToTrayButton"
                    Content="Hide to System Tray"
                    Width="180"
                    Height="45"
                    FontSize="16"
                    Click="OnHideToTrayButtonClicked"/>
		</StackPanel>
	</Grid>
</Window>