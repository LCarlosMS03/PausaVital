<Window x:Class="PausaVital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/PausaVital.ico"
        Title="Pausa Vital"
        Height="520"
        Width="408"
        MinHeight="520"
        MinWidth="408"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Background="#F0F4F8">

        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0"
                   Text="Pausa Vital"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Tarjeta principal -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="15"
                Margin="25,0,25,18"
                Padding="22">

            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.05"
                                  BlurRadius="10"
                                  ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">

                <!-- Mensaje de descanso reservado -->
                <Grid Height="34"
                      Margin="0,0,0,4">

                    <TextBlock x:Name="RestStatusText"
                               Text="DESCANSANDO... ¡NO TE MUEVAS!"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="DarkOrange"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Visibility="Hidden"/>
                </Grid>

                <!-- Tiempo de trabajo -->
                <TextBlock x:Name="WorkTimeLabel"
                           Text="TIEMPO DE TRABAJO"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#95A5A6"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock x:Name="WorkTimeText"
                           Text="00:00"
                           FontSize="48"
                           FontWeight="Light"
                           Foreground="#2980B9"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,18"/>

                <!-- Tiempo de inactividad -->
                <StackPanel HorizontalAlignment="Center"
                            Margin="0,0,0,24">

                    <TextBlock Text="TIEMPO DE INACTIVIDAD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#95A5A6"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="IdleTimeText"
                               Text="00:00"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Racha y escudos -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="StreakText"
                               Text="🔥 Racha: 0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#E67E22"
                               Margin="0,0,24,0"/>

                    <TextBlock x:Name="ShieldsText"
                               Text="🛡️ Escudos: 0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F1C40F"/>
                </StackPanel>

                <!-- Botón minimizar -->
                <Button x:Name="HideToBackgroundButton"
                        Content="Minimizar al fondo"
                        Height="40"
                        Background="#ECF0F1"
                        Foreground="#34495E"
                        BorderThickness="0"
                        Margin="0,28,0,0"
                        Cursor="Hand"
                        Click="OnHideToTrayButtonClicked">

                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius"
                                    Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

            </StackPanel>
        </Border>

        <!-- Estado de conexión -->
        <Border Grid.Row="2"
                Background="#E8ECEF">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Ellipse x:Name="ConnectionStatusDot"
                         Width="8"
                         Height="8"
                         Fill="Goldenrod"
                         Margin="0,0,6,0"/>

                <TextBlock x:Name="ConnectionStatusText"
                           Text="Iniciando conexión..."
                           FontSize="11"
                           Foreground="#7F8C8D"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>