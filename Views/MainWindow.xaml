<Window x:Class="PausaVital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pausa Vital" Height="400" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
	<Grid Background="#F0F4F8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="30"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Pausa Vital" FontSize="22" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,20,0,0"/>

		<Border Grid.Row="1" Background="White" CornerRadius="15" Margin="25,15" Padding="20">
			<Border.Effect>
				<DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
			</Border.Effect>

			<StackPanel VerticalAlignment="Center">
				<TextBlock Name="RestStatusText" Text="RESTING... DO NOT MOVE!" FontSize="14" FontWeight="Bold" Foreground="DarkOrange" HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>

				<TextBlock Text="WORK TIME" FontSize="12" FontWeight="SemiBold" Foreground="#95A5A6" HorizontalAlignment="Center" Margin="0,0,0,5"/>
				<TextBlock Name="WorkTimeText" Text="00:00" FontSize="48" FontWeight="Light" Foreground="#2980B9" HorizontalAlignment="Center" Margin="0,0,0,25"/>

				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
					<TextBlock Name="StreakText" Text="🔥 Streak: 0" FontSize="16" FontWeight="SemiBold" Foreground="#E67E22" Margin="0,0,20,0"/>
					<TextBlock Name="ShieldsText" Text="🛡️ Shields: 0" FontSize="16" FontWeight="SemiBold" Foreground="#F1C40F"/>
				</StackPanel>

				<Button Name="HideToBackgroundButton" Content="Hide to Background" Background="#ECF0F1" Foreground="#34495E" BorderThickness="0" Padding="10" Margin="0,30,0,0" Cursor="Hand" Click="OnHideToTrayButtonClicked">
					<Button.Resources>
						<Style TargetType="Border">
							<Setter Property="CornerRadius" Value="8"/>
						</Style>
					</Button.Resources>
				</Button>
			</StackPanel>
		</Border>

		<Border Grid.Row="2" Background="#E8ECEF">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Ellipse Name="ConnectionStatusDot" Width="8" Height="8" Fill="Goldenrod" Margin="0,0,6,0"/>
				<TextBlock Name="ConnectionStatusText" Text="Connecting..." FontSize="11" Foreground="#7F8C8D"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>