<Window x:Class="PausaVital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pausa Vital" Height="450" Width="800"
        WindowStartupLocation="CenterScreen">

	<Grid Background="#F5F5F5">
		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<TextBlock Text="Pausa Vital Dashboard"
                   FontSize="28"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>

		<StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
			<TextBlock Text="Current Streak: 0 Days"
                       FontSize="20"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>

			<Button Name="HideToTrayButton"
                    Content="Hide to System Tray"
                    Width="180"
                    Height="45"
                    FontSize="16"
                    Click="OnHideToTrayButtonClicked"/>
		</StackPanel>
	</Grid>
</Window>