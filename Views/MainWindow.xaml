<Window x:Class="PausaVital.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/Icons/PausaVital.ico"
        Title="Pausa Vital"
        Height="493"
        Width="408"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Grid Background="#F0F4F8" Margin="0,0,0,-6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="19*"/>
            <ColumnDefinition Width="117*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pausa Vital"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Left"
                   Margin="90,10,0,10" Grid.Column="1"/>

        <Border
                Background="White"
                CornerRadius="15"
                Margin="25,49,25,20"
                Padding="20" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="Black"
                                  Opacity="0.05"
                                  BlurRadius="10"
                                  ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel VerticalAlignment="Center" Height="276">
                <TextBlock x:Name="RestStatusText"
                           Text="DESCANSANDO... ¡NO TE MUEVAS!"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="DarkOrange"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="WorkTimeLabel"
                           Text="TIEMPO DE TRABAJO"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#95A5A6"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBlock x:Name="WorkTimeText"
                           Text="00:00"
                           FontSize="48"
                           FontWeight="Light"
                           Foreground="#2980B9"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,25"/>

                <StackPanel Margin="0,0,0,30"
                            HorizontalAlignment="Center">

                    <TextBlock Text="TIEMPO DE INACTIVIDAD"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#95A5A6" Height="14"
                               />

                    <TextBlock x:Name="IdleTimeText"
                               Text="00:00"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#7F8C8D"
                               HorizontalAlignment="Center"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <TextBlock x:Name="StreakText"
                               Text="🔥 Racha: 0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#E67E22"
                               Margin="0,0,24,0"/>

                    <TextBlock x:Name="ShieldsText"
                               Text="🛡️ Escudos: 0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#F1C40F"/>
                </StackPanel>

                <Button x:Name="HideToBackgroundButton"
                        Content="Minimizar al fondo"
                        Background="#ECF0F1"
                        Foreground="#34495E"
                        BorderThickness="0"
                        Padding="10"
                        Margin="0,30,0,0"
                        Cursor="Hand"
                        Click="OnHideToTrayButtonClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#E8ECEF" Grid.ColumnSpan="2" Height="29" VerticalAlignment="Top" Margin="0,378,0,0" Grid.RowSpan="2">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <Ellipse x:Name="ConnectionStatusDot"
                         Width="8"
                         Height="8"
                         Fill="Goldenrod"
                         Margin="0,0,6,0"/>

                <TextBlock x:Name="ConnectionStatusText"
                           Text="Iniciando conexión..."
                           FontSize="11"
                           Foreground="#7F8C8D"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
