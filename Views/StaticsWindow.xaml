<Window x:Class="PausaVital.Views.StatisticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Advanced Statistics" Height="480" Width="400"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F0F4F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#2C3E50" Margin="0,0,10,0" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            
            <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="SUCCESS RATE" FontSize="12" FontWeight="SemiBold" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                    <TextBlock Name="SuccessRateText" Text="0%" FontSize="48" FontWeight="Light" Foreground="#27AE60" HorizontalAlignment="Center" Margin="0,5,0,10"/>
                    <ProgressBar Name="SuccessProgressBar" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="#27AE60" Background="#ECF0F1" BorderThickness="0"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="COMPLETED" FontSize="11" FontWeight="SemiBold" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                        <TextBlock Name="CompletedText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2980B9" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="FAILED" FontSize="11" FontWeight="SemiBold" Foreground="#95A5A6" HorizontalAlignment="Center"/>
                        <TextBlock Name="FailedText" Text="0" FontSize="32" FontWeight="Bold" Foreground="#E74C3C" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <Border Grid.Row="2" Background="#E8ECEF" CornerRadius="8" Padding="10" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="Live System Idle Time: " FontSize="12" FontWeight="SemiBold" Foreground="#7F8C8D"/>
                <TextBlock Name="LiveIdleText" Text="00:00" FontSize="12" FontWeight="Bold" Foreground="#34495E"/>
            </StackPanel>
        </Border>

        <Button Grid.Row="3" Content="Close" Background="#ECF0F1" Foreground="#34495E" BorderThickness="0" Padding="10" Margin="0,15,0,0" Cursor="Hand" Click="OnCloseButtonClicked">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Button.Resources>
        </Button>
    </Grid>
</Window>